# ============================================================
# KhoTruyện AI — biến môi trường
# Sao chép file này thành `.env` rồi điền giá trị của bạn:
#   cp .env.example .env
# ============================================================

# --- WEB (Next.js, cổng 3000) ------------------------------------------

# SQLite cho Prisma (chế độ local). Đường dẫn tương đối tính từ prisma/schema.prisma.
# Lưu ý: khi deploy lên Vercel, DB không dùng nữa — mọi dữ liệu đi qua Engine.
DATABASE_URL=file:../db/custom.db

# URL của Engine service. ĐỂ TRỐNG khi chạy local (mặc định http://localhost:3002).
# Khi deploy Vercel: điền URL engine công khai, ví dụ:
#   ENGINE_URL=https://khotruyen-engine.up.railway.app
# Đặt biến này (host không phải localhost) sẽ tự bật chế độ "remote engine":
# mọi /api route chuyển sang proxy qua Engine thay vì đọc SQLite.
ENGINE_URL=

# Bật tường minh chế độ remote-engine (tùy chọn — tự bật khi ENGINE_URL ở host từ xa)
# ENGINE_READS=remote

# URL công khai của Engine cho trình duyệt (socket.io real-time).
# Phải có tiền tố NEXT_PUBLIC_ để Next.js nhúng vào client bundle.
# Khi deploy Vercel: NEXT_PUBLIC_ENGINE_URL=https://khotruyen-engine.up.railway.app
NEXT_PUBLIC_ENGINE_URL=

# --- ENGINE (mini-services/engine-service, cổng 3002) -------------------

# Cổng lắng nghe. Local: để trống (mặc định 3002).
# Railway/Render tự gán biến PORT — KHÔNG điền tay.
# PORT=3002

# Đường dẫn file SQLite của engine. Local: để trống (mặc định <repo>/db/custom.db).
# Khi deploy kèm volume: ENGINE_DB=/data/custom.db
ENGINE_DB=

# Ghi chú:
# - Gemini API key KHÔNG đặt trong env — thêm trực tiếp trong UI (Cài đặt → Gemini API key).
# - Supabase URL + service key cũng cấu hình trong UI (Cài đặt → Supabase), không cần env.
